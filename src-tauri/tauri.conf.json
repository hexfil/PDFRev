{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDFRev",
  "version": "1.0.0",
  "identifier": "cn.ipe.pdfrev",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PDFRev - PDF 页面修改器",
        "width": 1360,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true,
        "visible": false,
        "dragDropEnabled": false,
        "backgroundColor": "#1b1d21"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost blob: data:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}